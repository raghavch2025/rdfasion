# Required (the Vercel ↔ Supabase integration sets these, or copy them from
# Supabase → Project Settings → API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database setup at build time (scripts/migrate.mjs). One of these; the
# integration sets POSTGRES_URL_NON_POOLING. By hand: Supabase → Connect →
# Session pooler connection string.
DATABASE_URL=

# Optional
NEXT_PUBLIC_SITE_URL=              # only with a custom domain, e.g. https://rdfashion.in
WHATSAPP_NUMBER=919313877748       # fallback; the live number is in /admin/settings
NEXT_PUBLIC_IMAGE_TRANSFORM=       # "on" with Supabase Pro image transformation
CRON_SECRET=                       # daily retry of stuck AI image jobs
FAL_KEY=                           # AI model images
ANTHROPIC_API_KEY=                 # photo auto-fill
NEXT_PUBLIC_VAPID_PUBLIC_KEY=      # new-order notifications (npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rdfashion.in
